{
  "name": "altinkaya-mcp",
  "version": "0.0.0",
  "description": "MCP server for the Alt\u0131nkaya electronic enclosure catalog: search, parametric filtering, comparison and CAD files",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "altinkaya",
    "enclosure",
    "electronics",
    "cad",
    "step"
  ],
  "homepage": "https://github.com/amazeng-co/altinkaya-mcp#readme",
  "bugs": "https://github.com/amazeng-co/altinkaya-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazeng-co/altinkaya-mcp.git"
  },
  "license": "MIT",
  "author": "Amazeng",
  "mcpName": "io.github.amazeng-co/altinkaya-mcp",
  "type": "module",
  "bin": {
    "altinkaya-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "prepublishOnly": "npm run build",
    "crawl": "tsx scripts/crawl/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
